EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Native app calls Vercel/serverless API routes through this base URL.
# Example: https://your-app.vercel.app
EXPO_PUBLIC_API_BASE_URL=

# Claude Vision — kart tarama (sadece sunucu tarafı)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GiblTCG — %99 doğrulukla kart tanıma (sunucu tarafı)
GIBLTCG_API_KEY=your-gibltcg-key

# Pokémon TCG API — ücretsiz key: https://dev.pokemontcg.io
# Olmadan da çalışır ama key ile 20x daha yüksek limit + daha taze fiyat verisi
POKEMONTCG_API_KEY=your-pokemontcg-key
EXPO_PUBLIC_POKEMONTCG_API_KEY=your-pokemontcg-key

# TCGPlayer API — gerçek zamanlı fiyat (isteğe bağlı, en doğru kaynak)
# Key: https://developer.tcgplayer.com
TCGPLAYER_PUBLIC_KEY=your-tcgplayer-public-key
TCGPLAYER_PRIVATE_KEY=your-tcgplayer-private-key

# eBay — gerçek satış fiyatı + kart görseli (Naruto, One Piece vb. için kritik)
# Ücretsiz App ID: https://developer.ebay.com → My Account → Application Keys
EBAY_APP_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_SELL_ACCESS_TOKEN=your-ebay-sell-oauth-token
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MERCHANT_LOCATION_KEY=your-ebay-location-key
EBAY_CATEGORY_ID=your-ebay-category-id
EBAY_FULFILLMENT_POLICY_ID=your-fulfillment-policy-id
EBAY_PAYMENT_POLICY_ID=your-payment-policy-id
EBAY_RETURN_POLICY_ID=your-return-policy-id

# Shopify Admin GraphQL productSet
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token
SHOPIFY_API_VERSION=2026-04

# ikas Admin GraphQL
IKAS_ADMIN_API_URL=https://api.myikas.com/api/v1/admin/graphql
IKAS_ADMIN_ACCESS_TOKEN=your-ikas-admin-token

# Trendyol Marketplace
TRENDYOL_SELLER_ID=your-seller-id
TRENDYOL_API_KEY=your-api-key
TRENDYOL_API_SECRET=your-api-secret
TRENDYOL_BRAND_ID=your-brand-id
TRENDYOL_CATEGORY_ID=your-category-id
TRENDYOL_CARGO_COMPANY_ID=your-cargo-company-id
TRENDYOL_VAT_RATE=20

# Hepsiburada Marketplace
HEPSIBURADA_MERCHANT_ID=your-merchant-id
HEPSIBURADA_USERNAME=your-api-username
HEPSIBURADA_PASSWORD=your-api-password
HEPSIBURADA_CATEGORY_ID=your-category-id
HEPSIBURADA_PRODUCT_BASE_URL=https://mpop.hepsiburada.com
