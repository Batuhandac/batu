EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude Vision — kart tarama (mobil + sunucu)
ANTHROPIC_API_KEY=your-anthropic-api-key
EXPO_PUBLIC_ANTHROPIC_API_KEY=your-anthropic-api-key

# GiblTCG — %99 doğrulukla kart tanıma (sunucu tarafı)
GIBLTCG_API_KEY=your-gibltcg-key

# Pokémon TCG API — ücretsiz key: https://dev.pokemontcg.io
# Olmadan da çalışır ama key ile 20x daha yüksek limit + daha taze fiyat verisi
POKEMONTCG_API_KEY=your-pokemontcg-key
EXPO_PUBLIC_POKEMONTCG_API_KEY=your-pokemontcg-key

# TCGPlayer API — gerçek zamanlı fiyat (isteğe bağlı, en doğru kaynak)
# Key: https://developer.tcgplayer.com
TCGPLAYER_PUBLIC_KEY=your-tcgplayer-public-key
TCGPLAYER_PRIVATE_KEY=your-tcgplayer-private-key
