# PostHog analytics — client
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Places API (New) — konuma göre canlı veteriner verisi
# Google Cloud'da "Places API (New)" etkin olmalı (eski/legacy Places API değil).
# Kısıtla: API kısıtlaması = Places API (New); uygulama kısıtlaması = iOS bundle ID com.patisos.app
# CI build'lerinde bu dosya kullanılmaz — GitHub secret olarak ekle (.github/SECRETS_SETUP.md)
EXPO_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-api-key
