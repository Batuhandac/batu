rules_version = '2';

// Patiport — Firestore güvenlik kuralları
// Firebase Console → Firestore Database → Rules sekmesine yapıştırıp Publish et.
// Kullanıcılar görünmez anonim oturumla, veteriner hekimler yöneticinin açtığı
// e-posta hesabıyla girer (Authentication → Anonymous + Email/Password açık olmalı).
// Kişisel veri içeren koleksiyonlar (başvurular, bildirimler, şikayetler)
// uygulamadan okunamaz — yalnızca Firebase Console'dan (yönetici) görülür.
service cloud.firestore {
  match /databases/{database}/documents {

    function data() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(field, max) {
      return !(field in data()) || data()[field] == null || str(data()[field], 0, max);
    }
    function optBool(field) {
      return !(field in data()) || data()[field] == null || data()[field] is bool;
    }
    function stamped() { return data().created_at == request.time; }
    function device() { return str(data().device_id, 4, 80); }
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function onlyChanged(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }
    // Veteriner hekim: vets/{uid} belgesini yalnızca yönetici oluşturur
    function isVet() { return signedIn() && exists(/databases/$(database)/documents/vets/$(request.auth.uid)); }
    function vetDoc() { return get(/databases/$(database)/documents/vets/$(request.auth.uid)).data; }
    function isClinicVet(clinicId) { return isVet() && vetDoc().clinic_id == clinicId; }

    // ── Kullanıcıların eklediği klinikler: onaylanana kadar gizli ──────────
    // Yönetici Console'dan status alanını 'approved' yapınca görünür olur.
    match /community_clinics/{id} {
      allow read: if resource.data.status == 'approved';
      allow create: if str(data().name, 2, 120)
                    && data().lat is number && data().lng is number
                    && data().status == 'pending'
                    && optStr('phone', 30) && optStr('address', 200) && optStr('district', 60)
                    && device() && stamped();
      allow update, delete: if false;
    }

    // ── Klinik onaylı profiller: SADECE yönetici yazar (Console) ────────────
    match /clinic_profiles/{clinicId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Yorumlar: sahibi siler, kliniğin hekimi yalnızca yanıt yazar ─────────
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && data().keys().hasOnly(['clinic_id', 'author_uid', 'author_name', 'rating', 'comment', 'created_at'])
                    && data().author_uid == me()
                    && str(data().clinic_id, 3, 200)
                    && data().rating is int && data().rating >= 1 && data().rating <= 5
                    && str(data().comment, 0, 1000)
                    && str(data().author_name, 1, 40)
                    && stamped();
      allow delete: if signedIn() && resource.data.author_uid == me();
      allow update: if isClinicVet(resource.data.clinic_id)
                    && onlyChanged(['vet_reply'])
                    && (data().vet_reply == null
                        || (str(data().vet_reply.text, 1, 1000)
                            && str(data().vet_reply.name, 1, 160)
                            && data().vet_reply.at == request.time));
    }

    // ── Klinik fotoğrafları (dosya Storage'da, burada kaydı) ────────────────
    match /clinic_photos/{id} {
      allow read: if true;
      allow create: if str(data().clinic_id, 3, 200)
                    && str(data().url, 10, 1000)
                    && data().url.matches('https://firebasestorage\\.googleapis\\.com/.*')
                    && stamped();
      allow update, delete: if false;
    }

    // ── Veteriner hekim başvuruları ("Bu klinik benim") — kişisel veri ──────
    match /clinic_claims/{id} {
      allow read: if false;
      allow create: if str(data().clinic_name, 2, 120)
                    && str(data().claimant_name, 2, 100)
                    && str(data().claimant_phone, 7, 30)
                    && data().claimant_role in ['vet', 'owner', 'staff']
                    && data().consent == true
                    && data().status == 'pending'
                    && optStr('clinic_id', 200) && optStr('claimant_email', 120)
                    && optStr('clinic_phone', 30) && optStr('emergency_phone', 30)
                    && optStr('hours_text', 200) && optStr('note', 500)
                    && (!('claimant_uid' in data()) || data().claimant_uid == null
                        || (signedIn() && data().claimant_uid == me()))
                    && data().is_24_7 is bool && data().accepts_emergency is bool
                    && data().services is list && data().services.size() <= 20
                    && device() && stamped();
      allow update, delete: if false;
    }

    // ── Hatalı bilgi bildirimleri ───────────────────────────────────────────
    match /clinic_reports/{id} {
      allow read: if false;
      allow create: if str(data().clinic_id, 3, 200)
                    && str(data().report_type, 2, 40)
                    && optStr('detail', 500) && optStr('clinic_name', 120)
                    && device() && stamped();
      allow update, delete: if false;
    }

    // ── "Şu an açık mı?" teyitleri ──────────────────────────────────────────
    match /clinic_pings/{id} {
      allow read: if false;
      allow create: if str(data().clinic_id, 3, 200) && data().is_open_now is bool
                    && device() && stamped();
      allow update, delete: if false;
    }

    // ── Arama sonrası geri bildirim ─────────────────────────────────────────
    match /clinic_feedback/{id} {
      allow read: if false;
      allow create: if str(data().clinic_id, 3, 200)
                    && data().phone_answered is bool && optBool('accepted_emergency')
                    && device() && stamped();
      allow update, delete: if false;
    }

    // ── Kullanıcı profili: kişi yalnızca kendi belgesini okur/yazar ─────────
    // Rol yalnızca 'owner' ya da 'vet_pending' olabilir; hekimliği yönetici
    // vets/{uid} belgesiyle onaylar.
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
                            && data().keys().hasOnly(['name', 'role', 'title', 'created_at'])
                            && str(data().name, 1, 60)
                            && data().role in ['owner', 'vet_pending']
                            && (data().title == null || str(data().title, 1, 30));
    }

    // ── Tahsilat (lib/pos/sales.ts): panel "pending" yazar, sonucu POS ya da sunucu yazar ──
    // Modlar: "test" (panelin sanal terminali), "iyzico_test" (Patiport'un iyzico deneme
    // hesabı), "iyzico" (kliniğin kendi iyzico hesabı, server/odeme), "cash" (nakit).
    // Yalnızca kliniğin onaylı hekimleri görür ve yazar; sonuçlanan satış değişmez,
    // silinmez. Ödeme ve e-belge alanlarını (pay_*, edoc_*) yalnızca sunucu yazar.
    match /clinic_pos/{clinicId}/sales/{saleId} {
      allow read: if isClinicVet(clinicId);
      allow create: if isClinicVet(clinicId)
                    && data().keys().hasOnly(['amount_kurus', 'description', 'patient_id', 'patient_name', 'status', 'mode', 'created_by', 'created_at'])
                    && data().amount_kurus is int && data().amount_kurus >= 100 && data().amount_kurus <= 100000000
                    && str(data().description, 1, 120)
                    && (data().patient_id == null || str(data().patient_id, 1, 80))
                    && (data().patient_name == null || str(data().patient_name, 1, 60))
                    && data().status == 'pending' && data().mode in ['test', 'iyzico_test', 'iyzico', 'cash']
                    && data().created_by == me() && stamped();
      // Test POS'ta sonucu hekimin sanal terminali, nakitte hekim yazar. iyzico
      // satışlarında sonucu yalnızca ödeme sunucusu (hizmet hesabı, kurallara tabi değil)
      // yazar; hekim bekleyen satışı yalnızca iptal edebilir.
      allow update: if isClinicVet(clinicId)
                    && resource.data.status == 'pending'
                    && onlyChanged(['status', 'resolved_at', 'resolved_by', 'card_last4', 'auth_code'])
                    && data().resolved_at == request.time && data().resolved_by == me()
                    && ((resource.data.mode == 'test'
                         && data().status in ['approved', 'declined', 'cancelled']
                         && (data().status != 'approved'
                             || (str(data().card_last4, 4, 4) && str(data().auth_code, 6, 6))))
                        || (resource.data.mode == 'cash' && data().status in ['approved', 'cancelled']
                            && onlyChanged(['status', 'resolved_at', 'resolved_by']))
                        || (resource.data.mode in ['iyzico', 'iyzico_test'] && data().status == 'cancelled'
                            && onlyChanged(['status', 'resolved_at', 'resolved_by'])));
      allow delete: if false;
    }

    // ── Kliniğin bağlı hesapları (server/odeme): iyzico ve Paraşüt bağlantı özeti ──
    // Anahtar yok; yalnızca ortam, anahtarın son 4 hanesi, firma adı gibi bilgiler.
    // Yalnızca sunucu yazar.
    match /clinic_pay/{clinicId} {
      allow read: if isClinicVet(clinicId);
      allow write: if false;
    }

    // ── Şifreli anahtar kasası ve OAuth durumları: uygulamadan hiç okunamaz ─────
    match /clinic_secrets/{clinicId} {
      allow read, write: if false;
    }
    match /oauth_states/{state} {
      allow read, write: if false;
    }

    // ── Klinik e-belge ayarları: belge türü, KDV oranı, il/ilçe, kendiliğinden kes ──
    match /clinic_settings/{clinicId} {
      allow read: if isClinicVet(clinicId);
      allow create, update: if isClinicVet(clinicId)
                            && data().keys().hasOnly(['edoc_type', 'vat_rate', 'edoc_auto', 'edoc_city', 'edoc_district', 'updated_by', 'updated_at'])
                            && data().edoc_type in ['e_smm', 'e_archive']
                            && data().vat_rate in [0, 1, 10, 20]
                            && data().edoc_auto is bool
                            && str(data().edoc_city, 0, 40) && str(data().edoc_district, 0, 40)
                            && data().updated_by == me() && data().updated_at == request.time;
      allow delete: if false;
    }

    // ── Hekim anketi / tahsilat bekleme listesi (lib/data/vetInterest.ts) ───
    // Hesabı olan (anonim olmayan) herkes yalnızca kendi belgesini yazar; yönetici
    // konsoldan okur. Başvurusu onaylanmamış hekim de doldurabilir.
    match /vet_interest/{uid} {
      function okOpt(field, max) { return !(field in data()) || data()[field] == null || str(data()[field], 1, max); }
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
                            && request.auth.token.firebase.sign_in_provider != 'anonymous'
                            && data().keys().hasOnly(['clinic_name', 'current_software', 'pos_brand', 'esmm_way', 'wants', 'note', 'updated_at'])
                            && okOpt('clinic_name', 120) && okOpt('current_software', 80)
                            && okOpt('pos_brand', 40) && okOpt('esmm_way', 40) && okOpt('note', 300)
                            && data().wants is list && data().wants.size() <= 4
                            && data().wants.hasOnly(['tahsilat', 'randevu', 'sms', 'stok'])
                            && data().updated_at == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // ── Veteriner hekim hesapları: SADECE yönetici yazar ────────────────────
    // Alanlar: clinic_id, clinic_name, name, title (başka kişisel veri koyma)
    match /vets/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Ana sayfa bannerları: SADECE yönetici yazar ─────────────────────────
    match /app_banners/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── Klinik gelen kutusu: yönetici oluşturur, hekim açıp kapatır ─────────
    match /clinic_inboxes/{clinicId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isClinicVet(clinicId)
                    && onlyChanged(['open', 'response_hint'])
                    && data().open is bool
                    && (data().response_hint == null || str(data().response_hint, 0, 60));

      // Hekim cihazlarının bildirim jetonları: yalnızca hekim ve bu klinikle
      // konuşması olan kullanıcı okuyabilir
      match /private/{docId} {
        allow read: if signedIn()
                    && (isClinicVet(clinicId) || exists(/databases/$(database)/documents/conversations/$(clinicId + '__' + request.auth.uid)));
        allow write: if isClinicVet(clinicId) && docId == 'push'
                     && data().keys().hasOnly(['tokens'])
                     && data().tokens is list && data().tokens.size() <= 20;
      }
    }

    // ── Klinikle mesajlaşma ─────────────────────────────────────────────────
    // Belge kimliği: {clinicId}__{kullanıcıUid}; yalnızca iki taraf görür.
    function participant(c) {
      return signedIn() && (c.user_uid == me() || isClinicVet(c.clinic_id));
    }

    match /conversations/{convId} {
      allow get: if resource == null || participant(resource.data);
      allow list: if signedIn()
                  && (resource.data.user_uid == me() || isClinicVet(resource.data.clinic_id));
      allow create: if signedIn()
                    && data().user_uid == me()
                    && str(data().clinic_id, 3, 200)
                    && convId == data().clinic_id + '__' + me()
                    && get(/databases/$(database)/documents/clinic_inboxes/$(data().clinic_id)).data.open == true
                    && str(data().clinic_name, 1, 160)
                    && str(data().user_name, 1, 40)
                    && optStr('pet_summary', 300) && optStr('user_push', 200)
                    && data().last_text == '' && data().last_sender == 'user'
                    && data().user_unread == 0 && data().vet_unread == 0
                    && stamped() && data().last_at == request.time;
      allow update: if participant(resource.data)
                    && onlyChanged(['last_text', 'last_at', 'last_sender', 'user_unread', 'vet_unread', 'user_push', 'user_name', 'pet_summary'])
                    && data().last_sender in ['user', 'vet']
                    && data().user_unread is int && data().vet_unread is int
                    && str(data().last_text, 0, 140);
      allow delete: if false;

      match /messages/{mid} {
        function conv() { return get(/databases/$(database)/documents/conversations/$(convId)).data; }
        allow read: if participant(conv());
        allow create: if participant(conv())
                      && data().sender_uid == me()
                      && data().sender_role == (isClinicVet(conv().clinic_id) ? 'vet' : 'user')
                      && str(data().text, 1, 2000)
                      && str(data().sender_name, 0, 160)
                      && stamped();
        allow update, delete: if false;
      }
    }

    // ── Topluluk: soru-cevap ────────────────────────────────────────────────
    match /questions/{qid} {
      function answerPath(aid) { return /databases/$(database)/documents/questions/$(qid)/answers/$(aid); }

      // Yeni yanıt: sayaç aynı toplu yazmada tam 1 artar
      function answerAdded() {
        return onlyChanged(['answer_count', 'last_activity_at', 'last_answer_id', 'has_vet_answer'])
          && data().answer_count == resource.data.answer_count + 1
          && data().last_activity_at == request.time
          && !exists(answerPath(data().last_answer_id))
          && existsAfter(answerPath(data().last_answer_id))
          && getAfter(answerPath(data().last_answer_id)).data.author_uid == me()
          && (data().has_vet_answer == resource.data.has_vet_answer
              || (data().has_vet_answer == true
                  && getAfter(answerPath(data().last_answer_id)).data.is_vet == true));
      }

      // Yanıt silme: sayaç aynı toplu yazmada tam 1 azalır
      function answerRemoved() {
        return onlyChanged(['answer_count', 'last_answer_id'])
          && data().answer_count == resource.data.answer_count - 1
          && exists(answerPath(data().last_answer_id))
          && !existsAfter(answerPath(data().last_answer_id))
          && get(answerPath(data().last_answer_id)).data.author_uid == me();
      }

      allow read: if true;
      allow create: if signedIn()
                    && data().author_uid == me()
                    && str(data().author_name, 1, 160)
                    && data().species in ['dog', 'cat', 'other']
                    && data().topic in ['saglik', 'beslenme', 'davranis', 'asi', 'yavru', 'bakim', 'diger']
                    && str(data().title, 10, 120)
                    && str(data().body, 0, 2000)
                    && (data().photo_url == null
                        || (str(data().photo_url, 10, 1000)
                            && data().photo_url.matches('https://firebasestorage\\.googleapis\\.com/.*')))
                    && data().answer_count == 0 && data().has_vet_answer == false
                    && data().last_answer_id == null
                    && stamped() && data().last_activity_at == request.time;
      allow delete: if signedIn() && resource.data.author_uid == me();
      allow update: if signedIn() && (answerAdded() || answerRemoved());

      match /answers/{aid} {
        function questionPath() { return /databases/$(database)/documents/questions/$(qid); }
        function votePath() { return /databases/$(database)/documents/questions/$(qid)/answers/$(aid)/helpful/$(request.auth.uid); }

        allow read: if true;
        allow create: if signedIn()
                      && data().author_uid == me()
                      && str(data().author_name, 1, 160)
                      && str(data().body, 1, 2000)
                      && data().helpful == 0
                      && stamped()
                      && getAfter(questionPath()).data.last_answer_id == aid
                      && ((data().is_vet == false && data().vet_clinic_id == null && data().vet_clinic_name == null)
                          || (data().is_vet == true && isVet()
                              && data().vet_clinic_id == vetDoc().clinic_id
                              && data().vet_clinic_name == vetDoc().clinic_name));
        allow delete: if signedIn() && resource.data.author_uid == me()
                      && getAfter(questionPath()).data.answer_count == get(questionPath()).data.answer_count - 1;
        // "Faydalı" sayacı: yalnızca kişinin oy belgesiyle birlikte ±1
        allow update: if signedIn() && onlyChanged(['helpful'])
                      && ((data().helpful == resource.data.helpful + 1 && !exists(votePath()) && existsAfter(votePath()))
                          || (data().helpful == resource.data.helpful - 1 && exists(votePath()) && !existsAfter(votePath())));

        match /helpful/{voter} {
          function answerDoc() { return /databases/$(database)/documents/questions/$(qid)/answers/$(aid); }
          allow read: if signedIn() && voter == me();
          allow create: if signedIn() && voter == me()
                        && getAfter(answerDoc()).data.helpful == get(answerDoc()).data.helpful + 1;
          allow delete: if signedIn() && voter == me()
                        && getAfter(answerDoc()).data.helpful == get(answerDoc()).data.helpful - 1;
          allow update: if false;
        }
      }
    }

    // ── İçerik şikayetleri (App Store 1.2): yalnızca yönetici okur ──────────
    match /content_reports/{id} {
      allow read: if false;
      allow create: if signedIn()
                    && data().reporter_uid == me()
                    && data().kind in ['question', 'answer', 'review', 'message']
                    && str(data().path, 3, 300)
                    && data().reason in ['abuse', 'spam', 'misinfo', 'inappropriate', 'other']
                    && (data().author_uid == null || str(data().author_uid, 1, 128))
                    && data().status == 'open'
                    && stamped();
      allow update, delete: if false;
    }

    // ── Hekim paneli: sahip ile klinik arasında eşleştirme kodu ─────────────
    // Sahip dostunun kartından en fazla 2 gün geçerli 6 haneli bir kod üretir.
    // Kodu giren hekim hasta kaydını açar ve kodu bir kez "bağlandı" işaretler;
    // sahibin uygulaması böylece kliniğin kayıtlarını bulur. Kodlar listelenemez.
    match /pet_links/{code} {
      allow get: if signedIn()
                 && (resource.data.owner_uid == me() || (isVet() && resource.data.expires_at > request.time));
      allow list: if false;
      allow create: if signedIn() && data().owner_uid == me()
                    && code.matches('^[A-HJ-NP-Z2-9]{6}$')
                    && str(data().pet_local_id, 1, 80)
                    && data().pet is map && str(data().pet.name, 1, 60)
                    && data().pet.species in ['dog', 'cat', 'other']
                    && optStr('owner_name', 80) && optStr('owner_push', 200)
                    && data().expires_at is timestamp
                    && data().expires_at <= request.time + duration.value(2, 'd')
                    && data().clinic_id == null && data().patient_id == null
                    && stamped();
      allow update: if isVet() && resource.data.clinic_id == null
                    && resource.data.expires_at > request.time
                    && onlyChanged(['clinic_id', 'patient_id', 'clinic_name', 'linked_at'])
                    && data().clinic_id == vetDoc().clinic_id
                    && str(data().patient_id, 1, 80) && str(data().clinic_name, 1, 120)
                    && data().linked_at == request.time;
      allow delete: if signedIn() && resource.data.owner_uid == me();
    }

    // ── Hekim paneli: klinik hasta kartları ve kayıtları ────────────────────
    // Yalnızca o kliniğin hekimleri yazar. Kodla bağlanan hastanın sahibi kendi
    // dostunun kartını ve kayıtlarını okuyabilir (uygulama takvimine aktarır).
    match /clinic_patients/{clinicId}/patients/{pid} {
      function patientDoc() { return get(/databases/$(database)/documents/clinic_patients/$(clinicId)/patients/$(pid)).data; }
      function validPatient() {
        return str(data().name, 1, 60) && data().species in ['dog', 'cat', 'other']
          && optStr('breed', 60) && optStr('sex', 10) && optStr('birth_date', 10) && optStr('chip_no', 20)
          && (!('weight_kg' in data()) || data().weight_kg == null || data().weight_kg is number)
          && optStr('allergies', 300) && optStr('owner_name', 80) && optStr('owner_phone', 30)
          && optStr('note', 500) && optStr('owner_push', 200) && optStr('pet_local_id', 80)
          && optStr('next_due', 10) && optStr('next_due_title', 80)
          && data().updated_at == request.time;
      }
      // Sahip, ancak kendi ürettiği kod üzerinden bağlanabilir
      function ownerFromLink() {
        return data().owner_uid == null
          || (str(data().link_code, 6, 6)
              && get(/databases/$(database)/documents/pet_links/$(data().link_code)).data.owner_uid == data().owner_uid);
      }

      allow read: if isClinicVet(clinicId) || (signedIn() && resource.data.owner_uid == me());
      allow create: if isClinicVet(clinicId) && validPatient() && ownerFromLink()
                    && data().created_at == request.time;
      allow update: if isClinicVet(clinicId) && validPatient()
                    && data().created_at == resource.data.created_at
                    && data().owner_uid == resource.data.owner_uid;
      allow delete: if isClinicVet(clinicId);

      match /records/{rid} {
        function validRecord() {
          return data().kind in ['vaccine', 'rabies', 'internal_parasite', 'external_parasite', 'checkup',
                                 'medication', 'grooming', 'other', 'weight', 'note']
            && str(data().title, 1, 80) && str(data().date, 10, 10)
            && optStr('next_due', 10) && optStr('note', 1000)
            && (!('weight_kg' in data()) || data().weight_kg == null
                || (data().weight_kg is number && data().weight_kg > 0 && data().weight_kg < 200))
            && str(data().vet_name, 1, 80) && str(data().clinic_name, 1, 120)
            && data().vet_uid == me();
        }
        allow read: if isClinicVet(clinicId) || (signedIn() && patientDoc().owner_uid == me());
        allow create: if isClinicVet(clinicId) && validRecord() && data().created_at == request.time;
        allow update: if isClinicVet(clinicId) && validRecord() && data().created_at == resource.data.created_at;
        allow delete: if isClinicVet(clinicId);
      }
    }
  }
}
