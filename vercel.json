{
  "buildCommand": "EXPO_PUBLIC_APP_VERSION=${VERCEL_GIT_COMMIT_SHA:-local} EXPO_PUBLIC_BUILD_TIME=$(date +%s) npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/scan.js": { "memory": 256, "maxDuration": 15 },
    "api/gibl-scan.js": { "memory": 256, "maxDuration": 20 },
    "api/price.js": { "memory": 256, "maxDuration": 15 },
    "api/ebay-lookup.js": { "memory": 256, "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/scan", "destination": "/api/scan" },
    { "source": "/api/gibl-scan", "destination": "/api/gibl-scan" },
    { "source": "/api/price", "destination": "/api/price" },
    { "source": "/api/ebay-lookup", "destination": "/api/ebay-lookup" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
