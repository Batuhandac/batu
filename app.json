{
  "expo": {
    "name": "Pati SOS",
    "slug": "pati-sos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patisos.app",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Yakınındaki veteriner kliniklerini gösterebilmek için konumuna ihtiyacımız var.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Yakınındaki veteriner kliniklerini gösterebilmek için konumuna ihtiyacımız var.",
        "NSPhotoLibraryUsageDescription": "Kliniğe fotoğraf eklemek için galeri erişimine ihtiyacımız var."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.patisos.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki veteriner kliniklerini gösterebilmek için konumuna ihtiyacımız var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kliniğe fotoğraf eklemek için galeri erişimine ihtiyacımız var."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E53E3E",
          "sounds": []
        }
      ]
    ],
    "scheme": "patisos",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "387d0171-d147-4bd2-9b91-11898653b6b0"
      },
      "firebase": {
        "apiKey": "AIzaSyCREIbftWRcOL_Ag_hk3sPO2deHldhOwLs",
        "authDomain": "pati-sos.firebaseapp.com",
        "projectId": "pati-sos",
        "storageBucket": "pati-sos.firebasestorage.app",
        "messagingSenderId": "784978540632",
        "appId": "1:784978540632:web:dd88f7450290bcef2df22d"
      }
    },
    "owner": "batuhandac"
  }
}
