{
  "expo": {
    "name": "Cardory",
    "slug": "batu-tcg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.batu.tcg",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Kartlarınızı taramak için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Kartlarınızın fotoğraflarını yüklemek için galeri erişimi gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.batu.tcg",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Kartlarınızı taramak için kamera erişimi gereklidir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kartlarınızın fotoğraflarını seçmek için galeri erişimi gereklidir."
        }
      ]
    ],
    "scheme": "cardory",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a172296-dbc4-40fa-9b3a-f56f107f0f45"
      }
    },
    "owner": "batuhandac"
  }
}
