# Public (shipped in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (scripts/seed-supabase.js, scripts/send-push.js). Never ship.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: your own mirror of the map tiles (folder layout: {set}/{z}/{z},{y},{x}.jpg). Defaults to the open GitHub repo.
EXPO_PUBLIC_TILES_BASE_URL=
